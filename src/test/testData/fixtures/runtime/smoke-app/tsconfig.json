{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "preferSucceedSomeOrNone": "warning",
          "allOfMapToForEach": "warning",
          "catchIfTagToCatchTag": "warning",
          "flatMapIgnoredParamToAndThen": "warning"
        }
      }
    ]
  },
  "include": ["example.ts"]
}
