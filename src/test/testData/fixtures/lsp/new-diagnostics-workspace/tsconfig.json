{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "catchToOrElseSucceed": "warning",
          "redundantOrDie": "warning",
          "schemaNumber": "warning",
          "newSchemaClass": "warning"
        }
      }
    ]
  },
  "include": ["src"]
}
