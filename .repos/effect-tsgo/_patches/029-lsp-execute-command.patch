+package ls
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"sync"
+
+	"github.com/microsoft/typescript-go/internal/lsp/lsproto"
+)
+
+// ExecuteCommandHandler lets language-service extensions attach workspace
+// commands that still need a document-scoped LanguageService instance.
+type ExecuteCommandHandler struct {
+	TextDocumentURI func(*lsproto.ExecuteCommandParams) (lsproto.DocumentUri, error)
+	Execute         func(context.Context, *LanguageService, *lsproto.ExecuteCommandParams) (lsproto.ExecuteCommandResponse, error)
+}
+
+var (
+	executeCommandHandlersMu sync.RWMutex
+	executeCommandHandlers   = map[string]ExecuteCommandHandler{}
+)
+
+func RegisterExecuteCommandHandler(command string, handler ExecuteCommandHandler) {
+	if command == "" {
+		panic("execute command must not be empty")
+	}
+	if handler.TextDocumentURI == nil {
+		panic("execute command handler must provide TextDocumentURI")
+	}
+	if handler.Execute == nil {
+		panic("execute command handler must provide Execute")
+	}
+
+	executeCommandHandlersMu.Lock()
+	defer executeCommandHandlersMu.Unlock()
+	executeCommandHandlers[command] = handler
+}
+
+func ExecuteCommandNames() []string {
+	executeCommandHandlersMu.RLock()
+	defer executeCommandHandlersMu.RUnlock()
+
+	commands := make([]string, 0, len(executeCommandHandlers))
+	for command := range executeCommandHandlers {
+		commands = append(commands, command)
+	}
+	slices.Sort(commands)
+	return commands
+}
+
+func ExecuteCommandDocumentURI(params *lsproto.ExecuteCommandParams) (lsproto.DocumentUri, error) {
+	handler, ok := executeCommandHandler(params.Command)
+	if !ok {
+		return "", fmt.Errorf("unknown execute command: %s", params.Command)
+	}
+	return handler.TextDocumentURI(params)
+}
+
+func ExecuteCommand(ctx context.Context, languageService *LanguageService, params *lsproto.ExecuteCommandParams) (lsproto.ExecuteCommandResponse, error) {
+	handler, ok := executeCommandHandler(params.Command)
+	if !ok {
+		return lsproto.ExecuteCommandResponse{}, fmt.Errorf("unknown execute command: %s", params.Command)
+	}
+	return handler.Execute(ctx, languageService, params)
+}
+
+func executeCommandHandler(command string) (ExecuteCommandHandler, bool) {
+	executeCommandHandlersMu.RLock()
+	defer executeCommandHandlersMu.RUnlock()
+
+	handler, ok := executeCommandHandlers[command]
+	return handler, ok
+}
