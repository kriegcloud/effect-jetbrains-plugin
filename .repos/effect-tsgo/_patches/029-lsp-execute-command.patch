+func registerExecuteCommandRequestHandler(handlers handlerMap, info lsproto.RequestInfo[*lsproto.ExecuteCommandParams, lsproto.ExecuteCommandResponse], fn func(*Server, context.Context, *ls.LanguageService, *lsproto.ExecuteCommandParams) (lsproto.ExecuteCommandResponse, error)) {
+	handlers[info.Method] = func(s *Server, ctx context.Context, req *lsproto.RequestMessage) (func() error, error) {
+		params := req.Params.(*lsproto.ExecuteCommandParams)
+		uri, err := ls.ExecuteCommandDocumentURI(params)
+		if err != nil {
+			return nil, err
+		}
+		langService, err := s.session.GetLanguageService(ctx, uri)
+		if err != nil {
+			return nil, err
+		}
+		return func() error {
+			defer s.recover(req)
+			resp, lsErr := fn(s, ctx, langService, params)
+			// After any language service request, check if new global diagnostics were
+			// discovered during checking and push updated tsconfig diagnostics if so.
+			s.session.EnqueuePublishGlobalDiagnostics()
+			if lsErr != nil {
+				return lsErr
+			}
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			return s.sendResult(req.ID, resp)
+		}, nil
+	}
+}
